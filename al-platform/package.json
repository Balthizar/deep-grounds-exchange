{
  "name": "al-platform",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:actions": "node harness/check_actions.cjs",
    "test:behaviour": "node harness/behaviour.cjs",
    "test:minified": "node harness/behaviour.cjs --minified",
    "generate": "node scripts/gen-srd.mjs",
    "check": "tsc -b && npm run lint && npm run check:actions && npm run check:generated && npm run test:behaviour && npm run test:minified && npm run test:immutable && npm run test:transitions && vite build",
    "test:immutable": "node harness/immutability.cjs",
    "check:generated": "node harness/check_generated.cjs",
    "test:transitions": "node harness/transitions.cjs",
    "benchmark": "node server/stress.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "jsdom": "^29.1.1",
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
