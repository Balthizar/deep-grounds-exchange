{
  "name": "al-platform",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:actions": "node harness/check_actions.cjs",
    "test:behaviour": "node harness/behaviour.cjs",
    "test:minified": "node harness/behaviour.cjs --minified",
    "generate": "node scripts/gen-srd.mjs",
    "check": "tsc -b && npm run test:self && npm run lint && npm run check:actions && npm run check:generated && npm run check:content && npm run check:conformance && npm run check:ledger && npm run test:behaviour && npm run test:minified && npm run test:immutable && npm run test:reachability && npm run test:antiliteral && npm run test:transitions && npm run test:people && npm run test:sampler && npm run test:render && npm run test:facilities && vite build && npm run check:coverage",
    "test:immutable": "node harness/immutability.cjs",
    "check:generated": "node harness/check_generated.cjs",
    "test:transitions": "node harness/transitions.cjs",
    "benchmark": "node server/stress.mjs",
    "test:render": "node harness/render.cjs",
    "check:conformance": "node harness/conformance.cjs",
    "check:coverage": "node harness/coverage.cjs",
    "closeout": "node harness/closeout.cjs",
    "antiliteral": "node harness/anti_literal.cjs",
    "test:antiliteral": "node harness/anti_literal.cjs",
    "test:sampler": "node harness/sampler.cjs",
    "test:reachability": "node harness/reachability.cjs",
    "test:facilities": "node harness/facility_mint.cjs --minted",
    "facilities": "node harness/facility_mint.cjs --status",
    "test:self": "node harness/self_check.cjs",
    "report": "node harness/report.cjs",
    "next": "node harness/next.cjs",
    "check:ledger": "node harness/ledger.cjs",
    "check:content": "node harness/content_db.cjs",
    "build:content": "node server/build_content.mjs",
    "test:people": "node harness/people.cjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "jsdom": "^29.1.1",
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}